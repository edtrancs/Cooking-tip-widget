// Mapping function for OpenWeatherMap conditions
function mapOpenWeatherToCondition(mainWeather) {
  const conditionMap = {
    "Thunderstorm": "Rain",
    "Drizzle": "Drizzle",
    "Rain": "Rain",
    "Snow": "Cold",
    "Mist": "Cloudy",
    "Smoke": "Cloudy",
    "Haze": "Cloudy",
    "Dust": "Cloudy",
    "Fog": "Cloudy",
    "Sand": "Cloudy",
    "Ash": "Cloudy",
    "Squall": "Rain",
    "Tornado": "Rain",
    "Clear": "Clear",
    "Clouds": "Cloudy"
  };

  return conditionMap[mainWeather] || "Clear";
}

// Main function to get tip by weather
function getTipByWeather(weather, regions) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const data = sheet.getDataRange().getValues();
  const validRows = [];
  
  // Parse regions if provided
  const allowedRegions = regions ? regions.split(',') : null;
  
  const weatherFlavorMap = {
    "Rain": ["Spicy/Heat", "Savory/Complex", "Aromatic", "Earthy/Balanced"],
    "Hot": ["Light/Fresh", "Cooling", "Fresh/Herby", "Tangy/Bright"],
    "Clear": ["Grilled", "Balanced/Subtle", "Crunchy/Fresh", "Smoky"],
    "Drizzle": ["Warm/Comfort", "Savory/Complex", "Umami", "Earthy/Balanced"],
    "Cloudy": ["Aromatic", "Balanced/Subtle", "Umami"],
    "Cold": ["Savory/Complex", "Smoky", "Earthy/Balanced"]
  };

  const flavors = weatherFlavorMap[weather] || [];

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const flavor = row[5];
    const tip = row[6];
    const region = row[1];
    
    if (!flavors.includes(flavor)) continue;
    if (allowedRegions && !allowedRegions.includes(region)) continue;
    
    validRows.push({ tip: tip, region: region });
  }

  if (validRows.length > 0) {
    const randomIndex = Math.floor(Math.random() * validRows.length);
    return validRows[randomIndex];
  } else {
    return { tip: "Không có tip phù hợp cho thời tiết " + weather, region: "Unknown" };
  }
}

// Web app endpoint to handle requests
function doGet(e) {
  const originalWeather = e.parameter.weather;
  const description = e.parameter.description || '';
  const temperature = parseFloat(e.parameter.temp) || 0;
  const regions = e.parameter.regions; // ← Add regions parameter
  
  const mappedWeather = mapOpenWeatherToCondition(originalWeather);
  const result = getTipByWeather(mappedWeather, regions); // ← Pass regions
  
  return ContentService.createTextOutput(JSON.stringify({
    originalWeather: originalWeather,
    mappedWeather: mappedWeather,
    description: description,
    temperature: temperature,
    tip: result.tip,
    region: result.region
  })).setMimeType(ContentService.MimeType.JSON);
}

